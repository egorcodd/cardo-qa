  "panels": [
    {
      "id": 11,
      "title": "Переводы за 24 часа",
      "description": "Число уникальных переводов внутри Cardo и в другие банки за последние 24 часа. Источник — события, сохранённые с операцией в PostgreSQL. Входящая проводка и комиссия не считаются отдельными переводами.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cardo-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cardo_completed_operations{kind=~\"transfer|external_transfer\",window=\"24h\"})",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "wideLayout": true
      }
    },

    {
      "id": 15,
      "title": "Когда совершались операции",
      "description": "Уникальные события переводов и пополнений, дошедшие до Kafka и Kibana, по времени самой операции. Повтор одного eventId внутри интервала считается один раз. При задержке доставки график может появиться позже счётчика PostgreSQL. Доступная история ограничена сроком хранения логов.",
      "type": "timeseries",
      "datasource": {
        "type": "elasticsearch",
        "uid": "cardo-elasticsearch"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "query": "service:telemetry AND message:\"event.observed\" AND topic:(\"cardo.transfers.v1\" OR \"cardo.topups.v1\")",
          "metrics": [
            {
              "id": "1",
              "type": "cardinality",
              "field": "eventId"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "type",
              "settings": {
                "size": "3",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "3",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*banking\\.external-transfer\\.completed.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Перевод в другой банк"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*banking\\.transfer\\.completed.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Перевод внутри Cardo"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*banking\\.top-up\\.completed.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Пополнение"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "title": "Последние завершённые операции",
      "description": "До 20 уникальных финансовых операций в выбранном интервале, после доставки события через Kafka. Один eventId — одна строка, даже при повторной доставке. requestId позволяет найти цепочку в Kibana. Суммы показаны в валюте операции; персональные данные исключены.",
      "type": "table",
      "datasource": {
        "type": "elasticsearch",
        "uid": "cardo-elasticsearch"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "dsl",
          "query": "{\"size\":20,\"sort\":[{\"@timestamp\":\"desc\"}],\"collapse\":{\"field\":\"eventId\"},\"_source\":[\"@timestamp\",\"type\",\"amount\",\"currency\",\"operationId\",\"requestId\",\"eventId\"],\"query\":{\"bool\":{\"filter\":[{\"term\":{\"service\":\"telemetry\"}},{\"term\":{\"message\":\"event.observed\"}},{\"terms\":{\"topic\":[\"cardo.transfers.v1\",\"cardo.topups.v1\"]}},{\"range\":{\"@timestamp\":{\"gte\":\"$__from\",\"lte\":\"$__to\",\"format\":\"epoch_millis\"}}}]}}}",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "20"
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "@timestamp",
                "type",
                "amount",
                "currency",
                "operationId",
                "requestId"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "@timestamp": 0,
              "type": 1,
              "amount": 2,
              "currency": 3,
              "operationId": 4,
              "requestId": 5
            },
            "renameByName": {
              "@timestamp": "Время",
              "type": "Операция",
              "amount": "Сумма",
              "currency": "Валюта",
              "operationId": "ID операции",
              "requestId": "requestId"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Операция"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "banking.transfer.completed": {
                        "text": "Перевод внутри Cardo"
                      },
                      "banking.external-transfer.completed": {
                        "text": "Перевод в другой банк"
                      },
                      "banking.top-up.completed": {
                        "text": "Пополнение"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Время"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 210
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Время",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "События ожидают отправки в Kafka",
      "description": "Outbox — записи в PostgreSQL, которые сервис ещё не подтвердил как отправленные в Kafka. Отдельные очереди Banking и Engagement. Краткий рост после действия нормален; устойчивый рост требует проверки доставки.",

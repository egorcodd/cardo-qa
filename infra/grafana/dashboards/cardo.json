    {
      "id": 15,
      "title": "Когда совершались операции",
      "description": "Сохранённые завершённые операции по часам за выбранный период. Ноль означает отсутствие операций, ошибка источника показывается как ошибка. Состояние Kafka проверяется отдельно ниже.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cardo-operations"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cardo-operations"
          },
          "rawQuery": true,
          "rawSql": "WITH buckets AS (SELECT generate_series(date_trunc('hour',to_timestamp($__unixEpochFrom())),to_timestamp($__unixEpochTo()),interval '1 hour') AS time), kinds AS (SELECT unnest(ARRAY['Переводы','Пополнения']) AS metric) SELECT b.time,k.metric,count(h.event_id)::float8 AS value FROM buckets b CROSS JOIN kinds k LEFT JOIN banking.operation_history h ON h.occurred_at>=b.time AND h.occurred_at<b.time+interval '1 hour' AND $__timeFilter(h.occurred_at) AND CASE WHEN h.type='banking.top-up.completed' THEN 'Пополнения' ELSE 'Переводы' END=k.metric GROUP BY b.time,k.metric ORDER BY b.time,k.metric",
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 65,
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*banking\\.external-transfer\\.completed.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Перевод в другой банк"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*banking\\.transfer\\.completed.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Перевод внутри Cardo"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*banking\\.top-up\\.completed.*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Пополнение"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "title": "Последние завершённые операции",
      "description": "Последние 100 операций выбранного периода из постоянной истории. Пустая таблица при отсутствии операций в этом периоде ожидаема. Повтор Kafka не создаёт вторую строку.",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cardo-operations"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cardo-operations"
          },
          "rawQuery": true,
          "rawSql": "SELECT occurred_at AS \"Время\",CASE WHEN type='banking.top-up.completed' THEN 'Пополнение' ELSE 'Перевод' END AS \"Операция\",amount AS \"Сумма\",currency AS \"Валюта\",operation_id AS \"operationId\",request_id AS \"requestId\",event_id AS \"eventId\" FROM banking.operation_history WHERE $__timeFilter(occurred_at) ORDER BY occurred_at DESC,event_id DESC LIMIT 100",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Время",
            "desc": true
          }
        ]
      }
    },
    {

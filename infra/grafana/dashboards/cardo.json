    {
      "id": 11,
      "title": "Переводы за 24 часа",
      "description": "Число уникальных переводов внутри Cardo и в другие банки за последние 24 часа. Источник — события, сохранённые с операцией в PostgreSQL. Входящая проводка и комиссия не считаются отдельными переводами.",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cardo-operations"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cardo-operations"
          },
          "rawQuery": true,
          "rawSql": "SELECT count(*)::float8 AS value FROM banking.operation_history WHERE type LIKE 'banking.%transfer.completed' AND occurred_at>=now()-interval '24 hours'",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {

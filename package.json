{
  "name": "cardo-qa",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build --config apps/web/vite.config.js && node scripts/build-pwa.mjs",
    "typecheck": "tsc --noEmit && node scripts/check-web.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration.mjs tests/screens-integration.mjs tests/architecture-integration.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node services/gateway/index.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "pg": "8.16.3",
    "swagger-ui-express": "5.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/swagger-ui-express": "4.1.8",
    "@types/web-push": "3.6.4",
    "typescript": "5.9.3"
  }
}
